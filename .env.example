GITHUB_STORAGE_PATH=data/subscriptions.json
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_TOKEN=
SCHEDULER_TOKEN=
ADMIN_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
